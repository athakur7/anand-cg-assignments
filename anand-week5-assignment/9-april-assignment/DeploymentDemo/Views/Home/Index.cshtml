@{
    ViewData["Title"] = "Chandigarh - The City Beautiful";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Welcome to Chandigarh</h1>
        <p class="lead text-muted">
            Chandigarh, known as <strong>The City Beautiful</strong>, is famous for its modern architecture,
            clean roads, green spaces, and planned layout.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Rock Garden</h5>
                    <p class="card-text">
                        A world-famous sculpture garden created by Nek Chand, built from industrial and urban waste.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Sukhna Lake</h5>
                    <p class="card-text">
                        A peaceful man-made lake ideal for morning walks, boating, and enjoying scenic sunsets.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Rose Garden</h5>
                    <p class="card-text">
                        One of Asia’s largest rose gardens, featuring thousands of rose varieties and lush greenery.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <p class="mb-1"><strong>Capital of Punjab and Haryana</strong></p>
        <p class="text-muted">Designed by the Swiss-French architect Le Corbusier.</p>
    </div>
</div>
